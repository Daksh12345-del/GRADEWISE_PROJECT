# Frontend (Vite) environment variables
# Copy this file to ".env" in the project root and fill in real values.
# After editing .env, restart the dev server (npm run dev) for changes to take effect.

# Required — Clerk (used for authentication)
# Clerk Dashboard > API Keys > Publishable key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_Zmx1ZW50LWtvZGlhay00Ny5jbGVyay5hY2NvdW50cy5kZXYk

# Required — Supabase (used for reading site content + storing marks/grades data)
# Auth is now handled by Clerk — Supabase is used as a database only, accessed
# with a Clerk session token (see src/lib/supabase.js). You still need the URL
# + anon key from Supabase Dashboard > Project Settings > API Keys.
VITE_SUPABASE_URL=https://nwwjlfcibqlmilocqfmt.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im53d2psZmNpYnFsbWlsb2NxZm10Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzY1MDUzNTYsImV4cCI6MjA5MjA4MTM1Nn0.E7dFGikfXeTyJPskth79p5W-Qw8tQpsb-KhwIr8zEpI       # anon/public key, NOT the service_role key

# Required — URL of the Python backend (see backend/ folder), e.g.
# http://localhost:5050 for local dev, or your deployed Render URL
VITE_PYTHON_BACKEND_URL=http://localhost:5050
