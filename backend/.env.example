# Backend (Python) environment variables
# Copy this file to "backend/.env" and fill in real values.

# Server
PORT=5050

# Required — Supabase (used to cache/read internships & placements)
SUPABASE_URL=
SUPABASE_KEY=            # service_role key, NOT the anon key — Supabase Dashboard > Project Settings > API Keys > service_role

# Optional — extra internship/placement sources (backend works without these,
# just fetches from fewer sources)
RAPIDAPI_KEY=             # JSearch on RapidAPI
ADZUNA_APP_ID=
ADZUNA_API_KEY=

# Optional — raises GitHub API rate limit from 60/hr to 5000/hr
GITHUB_TOKEN=
